{
  "manifest_version": 3,
  "name": "Zalo → Việc local",
  "version": "1.4.0",
  "description": "Chuyển nội dung giao việc từ Zalo Web sang Nhật ký Ban Điện.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:4317/*", "https://bandien.github.io/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://chat.zalo.me/*"], "js": ["content.js"], "css": ["content.css"] },
    { "matches": ["https://bandien.github.io/scan/nhatky/*"], "js": ["nhatky.js"] }
  ]
}
