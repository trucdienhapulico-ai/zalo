{
  "manifest_version": 3,
  "name": "Zalo → Nhật ký Ban Điện",
  "version": "2.0.0",
  "description": "Dùng AI local để chuyển tin giao việc từ Zalo Web thẳng vào Nhật ký Ban Điện.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:4317/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://chat.zalo.me/*"], "js": ["content.js"], "css": ["content.css"] }]
}
