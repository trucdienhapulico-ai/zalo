{
  "manifest_version": 3,
  "name": "Zalo → Việc local",
  "version": "1.1.0",
  "description": "Phân loại tin giao việc bằng AI tự host và lưu trên máy.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:4317/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://chat.zalo.me/*"], "js": ["content.js"], "css": ["content.css"] }]
}
